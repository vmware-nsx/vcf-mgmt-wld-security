# Terraform state files
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl is committed on purpose so every run uses the same provider build

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
*.tfvars.local

# Crash log files
crash.log
crash.*.log

# Generated by Terraform providers
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# Local tooling
.claude/

# macOS
.DS_Store
